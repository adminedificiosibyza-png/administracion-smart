{
  // Nombre del Worker: debe ser IGUAL al nombre que se crea en el panel de Cloudflare
  "name": "administracion-smart",
  "compatibility_date": "2026-10-19",

  // Solo se publica la carpeta public/ (supabase/, serve.ps1 y demás quedan fuera)
  "assets": { "directory": "./public" },

  // Dominio del sistema (Cloudflare crea el DNS y el certificado HTTPS automáticamente)
  "routes": [
    { "pattern": "portal.ibyzaedificios.com", "custom_domain": true }
  ]
}
